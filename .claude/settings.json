{
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(./scripts/check.sh)",
      "Bash(python3 harness/next_feature.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git config:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production*)",
      "Read(./.env.development*)",
      "Read(./.env.staging*)",
      "Edit(/harness/evidence/**)",
      "Edit(/harness/integrity.py)",
      "Edit(/.githooks/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/session-start.sh" }] }
    ],
    "SubagentStop": [
      { "matcher": "^verifier$", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/verifier-evidence.py" }] },
      { "matcher": "^architect$", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/verifier-evidence.py" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/stop-gate.sh" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/audit.py" }] }
    ]
  }
}
